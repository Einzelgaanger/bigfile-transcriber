# Client (safe to expose — anon key only)
VITE_SUPABASE_URL=https://your-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server only. Do not use a VITE_ prefix. Set the same values on Supabase:
#   npx supabase secrets set ASSEMBLYAI_API_KEY=... OPENROUTER_API_KEY=... OPENROUTER_MODEL=anthropic/claude-sonnet-4 --project-ref fvdwagawkounsofwsyen
ASSEMBLYAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# Coolify / MinIO (runtime on the app container; S3_* also as Supabase function secrets)
# S3_PUBLIC_URL must be the public HTTPS origin of MinIO API (port 9000), not http://minio:9000
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_PUBLIC_URL=https://s3.your-domain
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=media-uploads
S3_REGION=us-east-1
